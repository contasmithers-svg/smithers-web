/*
  Strict-Transport-Security: max-age=31536000; includeSubDomains; preload
  X-Frame-Options: DENY
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), geolocation=(), microphone=(), payment=()
  Content-Security-Policy: default-src 'self'; script-src 'self' https://www.googletagmanager.com https://*.google-analytics.com; style-src 'self' 'unsafe-inline'; img-src 'self' data: https://*.google-analytics.com https://www.googletagmanager.com; font-src 'self'; connect-src 'self' https://*.google-analytics.com https://*.analytics.google.com https://www.googletagmanager.com; form-action 'self'; frame-src 'self' https://www.google.com https://reservation.dish.co; object-src 'none'; base-uri 'self'; frame-ancestors 'none'
# === Cache de estaticos ===
# Fotos: cambian de vez en cuando (cartas de temporada) -> 30 dias
/assets/img/*
  Cache-Control: public, max-age=2592000

# CSS y JS llevan ?v= en la URL, asi que un cambio de version invalida la
# cache por si solo: se pueden cachear de forma agresiva sin servir nada viejo.
/assets/css/*
  Cache-Control: public, max-age=31536000, immutable
/assets/js/*
  Cache-Control: public, max-age=31536000, immutable

# Iconos
/favicon.ico
  Cache-Control: public, max-age=2592000
/favicon.svg
  Cache-Control: public, max-age=2592000
/apple-touch-icon.png
  Cache-Control: public, max-age=2592000

# cookies.js no lleva version en la URL: revalidar siempre para poder corregir
# el banner de consentimiento sin esperar a que caduque una cache.
/cookies.js
  Cache-Control: public, max-age=0, must-revalidate

# === SEO ===
# Manifest PWA: tipo correcto para navegadores y crawlers
/site.webmanifest
  Content-Type: application/manifest+json; charset=utf-8
  Cache-Control: public, max-age=86400

# Sitemap y robots: revalidar a menudo para que Google vea los cambios pronto
/sitemap.xml
  Content-Type: application/xml; charset=utf-8
  Cache-Control: public, max-age=3600
/robots.txt
  Cache-Control: public, max-age=3600

# Ficheros para agentes de IA: texto plano legible, no descarga
/llms.txt
  Content-Type: text/plain; charset=utf-8
  Cache-Control: public, max-age=3600
/llms-full.txt
  Content-Type: text/plain; charset=utf-8
  Cache-Control: public, max-age=3600
/*.md
  Content-Type: text/markdown; charset=utf-8
  Cache-Control: public, max-age=3600

# Clave de verificacion de IndexNow: texto plano para que Bing pueda validarla
/3e085a53eac2e7caa62e386202ebb2b6.txt
  Content-Type: text/plain; charset=utf-8
  Cache-Control: public, max-age=3600

# Documentacion interna y utilidades: fuera del indice de los buscadores
/AUDITORIA_COMPLETA.md
  X-Robots-Tag: noindex, nofollow
/AUDITORIA_HTML.md
  X-Robots-Tag: noindex, nofollow
/BRIEF_FINAL.md
  X-Robots-Tag: noindex, nofollow
/README_SUBIDA.md
  X-Robots-Tag: noindex, nofollow
/REGISTRO_VERSIONES.md
  X-Robots-Tag: noindex, nofollow
/Resenas_Smithers_GBP.docx
  X-Robots-Tag: noindex, nofollow
/Resenas_Smithers_GBP_con_respuestas.docx
  X-Robots-Tag: noindex, nofollow
